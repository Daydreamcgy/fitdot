{
  "app": {
    // 签名配置不随仓库分发：首次运行时在 DevEco Studio 里
    // Project Structure → Signing Configs 勾选「Automatically generate signature」即可。
    "products": [
      {
        "name": "default",
        // HarmonyOS 7 / API 26。注意：API 26 起版本号必须写成带补丁号的完整字符串
        // "26.0.0"，只写 "26" 会导致工程同步失败。
        // compatibleSdkVersion = 应用能安装的最低系统版本；改成更低的值可兼容旧机型，
        // 但用到高版本 API 时需要自己做版本判断。
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true,
            // 编译期校验：调用了高于 compatibleSdkVersion 的 API 直接报错。
            "apiCompatibilityCheck": "error"
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
