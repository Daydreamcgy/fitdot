{
  // 工程级依赖配置。
  // ⚠️ modelVersion 必须等于当前 SDK 的 platformVersion。
  // hvigor 源码 `version-const.js` 中：
  //   CURRENT_MODEL_VERSION = getLatestSupportVersion().getPlatformVersion().getVersion()
  // 本机 SDK 的 platformVersion 是 "26.0.0"（见 <IDE>\sdk\default\sdk-pkg.json）。
  // 另：hvigor-ohos-plugin 明确报错「When the API version is 26.0.0 or higher,
  // upgrade the modelVersion ... to 6.0.0 or higher」，填 5.0.0 会直接构建失败。
  "modelVersion": "26.0.0",
  "description": "健身打卡 - HarmonyOS 7 (API 26) 本地健身历程记录与打卡应用",
  "dependencies": {},
  "devDependencies": {
    "@ohos/hypium": "1.0.19",
    "@ohos/hamock": "1.0.0"
  }
}
